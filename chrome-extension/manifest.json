{
  "manifest_version": 3,
  "name": "Calendar Autobot AI",
  "version": "1.0.0",
  "description": "AI-powered text/image-to-calendar events extraction",
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "oauth2": {
    "client_id": "609660480116-tnd7the9ooj8sd6rt4grjj7hcpt5frjf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calendar AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg", 
    "128": "icons/icon.svg"
  }
}