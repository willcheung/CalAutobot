{
  "manifest_version": 3,
  "name": "CalAutobot: Screenshots to Google Calendar",
  "version": "1.0.5",
  "description": "AI calendar agent that automatically creates Google Calendar events from screenshots, emails and attachments.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "contextMenus"
  ],
  "oauth2": {
    "client_id": "609660480116-tnd7the9ooj8sd6rt4grjj7hcpt5frjf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Event Creator"
  },
  "background": {
    "service_worker": "background.js"
  }
}