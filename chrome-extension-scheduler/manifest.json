{
  "manifest_version": 3,
  "name": "CalAutobot Scheduler Helper",
  "description": "Insert CalAutobot availability or booking links directly into Gmail compose windows.",
  "version": "0.1.0",
  "permissions": [],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://calautobot.com/*",
    "https://www.calautobot.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
