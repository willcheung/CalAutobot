{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/build_retired_site.mjs",
  "outputDirectory": "public",
  "routes": [
    { "src": "/health", "dest": "/health.json" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/image-to-calendar", "dest": "/image-to-calendar.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/retired.html", "status": 410 }
  ]
}
